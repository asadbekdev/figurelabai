# Server-only. Set these in Dokploy — never commit real values.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
# fixture | gemini. Unset uses gemini when GEMINI_API_KEY is present, otherwise fixture.
# MODEL_PROVIDER=gemini
FIXTURE_STAGE_DELAY_MS=550
# Optional local/CI override for an isolated durable job file.
FIGURELAB_JOB_STORE_PATH=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
# Default Nano Banana. Offerings also call gemini-3-pro-image and gemini-3.1-flash-image.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Optional. When set, POST/GET /api/v1/figures require X-Api-Key or Authorization: Bearer.
FIGURELAB_API_KEY=
